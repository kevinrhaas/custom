.DS_Store
.gitignore
__pycache__/
*.pyc

# Large reference PDFs/scans (exceed GitHub 100MB limit) - keep local only.
# The small newspaper transcriptions in newspapers/Transcriptions/ ARE committed.
chicago/reference/Andreas-History_of_Chicago.pdf
chicago/reference/planning/Andreas-History_of_Chicago.pdf
chicago/reference/newspapers/**/*.pdf
chicago/reference/newspapers/*.pdf

# Large video captures - keep local only
chicago/reference/movies/

# Wau-Bun text sources: the author's .docx dump and the 500 KB public-domain
# epub. The generated per-scene passages ARE committed (site/wau-bun/js/).
wau-bun/sources/
# per-scene dumps of the (uncommitted) source text, regenerated by build-text.py
wau-bun/source-scenes/

# Stay Finder: generated single-file bundle for publishing (see stay/build-artifact.py)
site/stay/artifact.html

# Stay Finder: cached TIGERweb downloads for the map builder
stay/geo-cache/
